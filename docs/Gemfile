source "https://rubygems.org"

# Pin to GitHub Pages' supported Jekyll set so local preview matches what
# GH Pages serves. See https://pages.github.com/versions/ for the matrix.
gem "github-pages", group: :jekyll_plugins

# just-the-docs theme is loaded via `remote_theme` in _config.yml so it
# doesn't need to be in the gem list — but jekyll-remote-theme does.
group :jekyll_plugins do
  gem "jekyll-remote-theme"
  gem "jekyll-seo-tag"
end

# Windows / JRuby compatibility shims (harmless on macOS/Linux too).
platforms :mingw, :x64_mingw, :mswin, :jruby do
  gem "tzinfo", ">= 1", "< 3"
  gem "tzinfo-data"
end

gem "wdm", "~> 0.1.1", :platforms => [:mingw, :x64_mingw, :mswin]
gem "webrick", "~> 1.7"
